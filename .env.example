# Copy to .env. Never put credentials in frontend variables.
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# For Gemini use LLM_PROVIDER=gemini and LLM_MODEL=gemini-2.5-flash.
LLM_TIMEOUT_MS=60000
LLM_RETRIES=2
LLM_CONCURRENCY=1
CANDIDATES_PER_EPISODE=1
LLM_TOKENS_PER_MINUTE=7500
LLM_DAILY_TOKEN_BUDGET=190000
LLM_MAX_COMPLETION_TOKENS=2000
BASELINE_SAMPLE_SIZE=5
PORT=3001

# Vercel + MongoDB Atlas. Set these in Vercel Project Settings, not VITE_* variables.
# Locally leave STORAGE_BACKEND=local to keep your existing JSON files.
STORAGE_BACKEND=local
MONGODB_URI=
MONGODB_DB=kuku_promo
# Hosted workspace opens directly without a password.
# Optional canonical origin, e.g. https://your-project.vercel.app
APP_ORIGIN=
# HOSTED_MODE=true is only for hosted-mode verification outside Vercel.
